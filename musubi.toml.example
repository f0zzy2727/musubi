# musubi.toml.example
# Copy this to musubi.toml and update the values for your project.
# musubi.toml is gitignored — this file is the shareable template.

[project]
path = "/path/to/your/project"           # absolute path to the codebase the agents will work on

# Optional — who the human lead is. Oya and the orchestrator address the
# operator by this handle at runtime (prompt, console relays). Without this
# block, sessions fall back to the runbook's generic role handle @LEAD.
# [operator]
# handle = "@YOU"                        # your comms handle (leading @ optional)
# name = "Your Name"                     # display name — informational

[agents]

[agents.opus]
name = "Opus"                            # display name — change to whatever you like
handle = "@OPUS"                         # used in comms file headers and relay routing
cli = "claude"                           # CLI command to start this agent

[agents.coda]
name = "Coda"                            # display name — change to whatever you like
handle = "@CODA"                         # used in comms file headers and relay routing
cli = "codex"                            # CLI command to start this agent

[comms]
file = "docs/agents/comms/active.txt"    # active comms transcript — relative to project root
                                         # gitignore docs/agents/comms/ in your project
                                         # archive completed cycles to docs/agents/archive/ and commit those
                                         # absolute paths (e.g. /tmp/agent_comms.txt) also work but won't survive a reboot
over_signal = "<OVER>"                   # turn signal — agents append this when done with a message
runbook = "docs/agents/AGENT_COLLAB_RUNBOOK.md"          # protocol authority (per-cycle rules)
operating_model = "docs/agents/PAIR_OPERATING_MODEL.md"  # rationale + adoption guide

# Optional tuning knobs (uncomment to override defaults):
# archive_dir = "docs/agents/archive"                    # where rotated comms transcripts land; relative to project.path
# send_pause_seconds = 0.5                               # pause between paste and Enter in relay; raise for high-latency tmux (SSH)
# stall_seconds = 45                                     # how long to wait for <OVER> before nudging the writing agent
# idle_wake_seconds = 300                                # silence watchdog (idle-1): wake the orchestration layer after the
#                                                        # channel is fully quiet this long with nothing pinned for the operator.
#                                                        # 0 disables. Skips any pane holding an unsent typed line (would garble it).
# context_warn_k = 400                                   # context-budget watchdog: warn the operator (operator-action surface)
#                                                        # when a coder pane reaches this many THOUSAND tokens, before it stalls /
#                                                        # dies of context exhaustion (a nudge can't recover a context-dead pane). 0 disables.
# pane_idle_seconds = 240                                # per-pane park watchdog (stall-class 3): nudge a single coder pane that
#                                                        # parked after its own turn (idle, not working/at-a-modal/holding an unsent
#                                                        # line) for this long, even while the channel is not quiet; escalates to the
#                                                        # operator if it still doesn't self-clear. Coders only. 0 disables.
# baton_grace_seconds = 90                               # comms-drop watchdog (stall-class 2): warn the operator when a capsule/
#                                                        # verdict update lands over a quiet, fully-relayed channel but no comms
#                                                        # append follows this long (a dropped relay baton — a verdict that never
#                                                        # relayed, the S3/S4 field bug). 0 disables.
#                                                        # NOTE: permission-modal detection (stall-class 1) is always on — no knob.
# max_wakes_per_window = 10                              # wake-loop circuit-breaker (burn-1): cap on pane keystroke-nudges (silence +
# wake_window_seconds = 3600                             # park watchdogs combined) per rolling window. Each nudge provokes an agent
#                                                        # turn = a context reload = tokens; a sustained max-rate means a stuck channel
#                                                        # the nudges aren't clearing (a self-feeding loop). On trip the watcher
#                                                        # SUPPRESSES further nudges and alarms the operator instead of burning tokens
#                                                        # unattended (the 2026-06-30 ~$100/hr incident); self-heals as the rate falls.
#                                                        # max_wakes_per_window = 0 disables. Wakes only accrue while stuck, so a healthy
#                                                        # session's sporadic wakes never trip the default 10/hour.
# rotate_max_bytes = 200000                              # rolling comms rotation (relay-1): when active.txt grows past this many
#                                                        # bytes AND the channel is fully drained AND quiet for rotate_quiet_seconds,
#                                                        # the watcher archives it (archive/agent_comms_<date>_*.txt) and resets to 0
#                                                        # — no manual orchestrator "bounce" needed, no orphan-tail risk (it only
#                                                        # rotates at a drained boundary, never mid-message). 0 disables.
# rotate_quiet_seconds = 60                              # how long the channel must be quiet before a rolling rotation fires, so a
#                                                        # live exchange is never split across two archive files.
# auto_rotate_managed_docs = true                        # boot auto-hygiene (docs-2): on each clean launch, archive + trim any cycle
#                                                        # doc (capsule / handoff / todo) grown past managed_doc_rotate_chars, so the
#                                                        # pair never warm-starts from a bloated multi-week log (the recurring "Oya
#                                                        # lost context / spaghetti" failure). Archive-safe (full copy kept); the
#                                                        # capsule is TRIMMED to its skeleton, never blanked. false = manual only.
# managed_doc_rotate_chars = 40000                       # size over which the boot auto-rotation acts (defaults to the warn level).
session_name = "musubi"                  # tmux session name — change if running multiple sessions

# --- Optional: orchestrator boot guards -------------------------------------
# [orchestrator]
# detachment_threshold_days = 2          # orch-7: warn at boot when code commits run
#                                        # this many days ahead of capsule/comms updates
#                                        # (work happened outside the orchestrator)

# --- Optional: Oyakata (Oya) third-agent layer -----------------------------
# Default musubi is a two-agent pair (Opus + Coda). Oya is an optional third
# agent — a supervisor who watches the pair, builds context across events, and
# intervenes via `@OYA` comms messages when judgement-shaped patterns warrant
# it. Most projects do NOT need this; the pair plus the v1.7 mechanical guards
# is enough for most cycles.
#
# Enable Oya when:
#   - Cycles are long/complex and asymmetric-deference risk is real
#   - You want a third-mind audit of your pair's Findings discipline
#   - You're remote/away and want better in-flight cycle visibility
#
# To enable: uncomment the block below and set `enabled = true`. The
# orchestrator auto-spawns the Oya pane (via scripts/attach-oya.sh) on your
# next launch of musubi — no extra commands or flags. See
# docs/operator/oyakata-prompt-v0.1.md for the full prompt + behavioural
# contract Oya runs under.
#
# [agents.oyakata]
# enabled = true                              # turn on the Oya layer
# handle = "@OYA"                             # comms handle Oya posts under
# pane_title = "OYAKATA"                      # tmux pane title substring
# heartbeat_threshold = 5                     # warn if Oya hasn't written this many relays in a row
# notify_on_capsule_edit = true               # ping Oya when docs/agents/current-state.md changes
# log_path = "docs/agents/oyakata-log.md"     # where Oya writes observations (relative to project.path)
# context_docs = ["docs/PRODUCT-VISION.md", "docs/ROADMAP.md", "docs/ARCHITECTURE.md"]
#   ^ Optional. Explicit vision/architecture/roadmap docs Oya reads at startup so
#     she can custodian the strategy, not just the code. Paths are relative to
#     project.path. If omitted, Oya auto-discovers the recognised files
#     (PRODUCT-VISION/VISION/PRD/README, docs/adr/*, ROADMAP/BACKLOG) and asks you
#     on turn one if she finds none. Set this to guarantee she reads YOUR docs.
#     NEVER point this at a musubi-managed file (first line carries the
#     '<!-- musubi-managed: -->' marker, e.g. docs/agents/IaA.md) — those are
#     process templates with no product knowledge, and bootstrap.sh refreshes
#     them. doctor.sh warns if you do; Oya treats them as a missing north-star.
# contested_debate = false                    # SPIKE, off by default
#   ^ Opt into forced-debate mechanism #1 (blind position-commitment). When true,
#     a `blast_radius: high` slice (state/schema/CI/UI/>300 LOC, per
#     scripts/classify-slice.sh) that reaches review runs Oya's blind Phase 1/2:
#     both coders commit a Position + Confidence to Oya BEFORE either reads the
#     other, then Oya releases both and forces reconciliation. This is the one
#     place Oya HOLDS a barrier rather than only advising — that's why it's opt-in.
#     Measure single_exchange_contested_rate (scripts/comms-metrics.py) before/after
#     and keep it only if it moves. See
#     docs/positioning/collaboration-improvements-forced-debate.md.

# --- Optional: [agents.oyakata.permissions] block (oyakata-2 PreToolUse hook) -
# Auto-approves a small fixed allowlist of read-only operations on Opus's
# Claude Code so it doesn't halt on permission prompts for `Read`, `Grep`,
# `Glob`, `NotebookRead`, or METADATA-ONLY Bash commands (`git status`/
# `branch`/`rev-parse`/`ls-files`, `git log --oneline`, `pwd`, `ls`, `wc`,
# `file`, `stat`, `which`, etc.). Anything containing a shell metacharacter
# (|, >, <, ;, &, $, $(, backtick) defers regardless — note `$` (any env
# expansion) is fenced so `echo $TOKEN` never auto-approves. Everything else
# falls through to the normal permission flow — the operator still decides.
#
# DISCLOSURE-AWARE (sec-1, 2026-06-16). "Non-mutating" is not "safe to
# disclose": commands that print file CONTENT or config/credentials —
# `git show`, `git diff`, `git log` (general), `git config`, `git remote -v`,
# `git blame` — DEFER by default, because `git show HEAD:.env` discloses a
# tracked secret just as `cat .env` would. `cat`/`head`/`tail`/`printenv`/`env`
# are never auto-approved at all. If you know this repo holds no secrets worth
# protecting from a read, opt back into the disclose tier with the [security]
# block below.
#
# Closes the canonical Opus-halted-on-permission case from the 2026-05-15
# spike (~2 hours blocked on a read prompt). See docs/operator/oyakata-permissions.md
# for the wiring details and what's NOT in this slice (Oya-as-decider,
# escalation, Codex parity).
#
# When `enabled = true`, the orchestrator idempotently registers the hook
# in `<project_path>/.claude/settings.local.json` on each launch. Adds the
# entry on first run; updates the command path if you move your musubi
# checkout; no-ops if the entry already matches. The orchestrator NEVER
# touches your project's `.claude/settings.json` (committed config) — only
# the gitignored `.claude/settings.local.json`.
#
# This is OPT-IN. Default is off because the hook changes the agent's
# authority surface (auto-approves without prompting).
#
# Mirror the gitignore entry from musubi's own .gitignore into your
# project's .gitignore:
#   docs/agents/oyakata-decisions.md
#
# [agents.oyakata.permissions]
# enabled = true                              # opt into the PreToolUse hook layer

# --- Optional: [security] block --------------------------------------------
# repo_has_no_secrets re-enables auto-approval of the content/config-disclosing
# read commands (`git show`/`diff`/`log`/`config`/`remote`/`blame`) AND the
# agents' boot orientation reads (`sed -n`/`tail`/`head`/`cat`/`nl`/`rg`/`grep`)
# that the PreToolUse hook defers by default — the single biggest source of
# per-session permission friction. Set it ONLY if this repo contains nothing
# you'd mind a read disclosing (no tracked .env, no credential-bearing git
# config/remotes, no secrets in history). Leaving it unset is the safe default.
# Even WITH the opt-in, an orientation read still defers when its target is
# out-of-repo (absolute/`~`/`..`) or a secret-bearing filename (`.env`, `*.key`,
# `*.pem`, `id_rsa`, …). Bare-`$` env expansion and `printenv`/`env` are NEVER
# re-enabled by this flag.
#
# Surfaced to the hook via the MUSUBI_REPO_HAS_NO_SECRETS env var; you can also
# export that directly in your shell before launch.
#
# [security]
# repo_has_no_secrets = false                 # true = opt into the disclose tier

# --- Optional: [requires.skills] block (v0.3+ strategic-Oya prereq) --------
# Strategic-Oya (v0.3 and later) leans on gstack for the engineering-discipline
# artefacts she watches for — threat models (cso), architecture reviews
# (plan-eng-review), pre-landing diff reviews (review). When this block is
# present, the orchestrator checks at startup that the declared skills are
# installed and warns loudly on missing core skills. It NEVER refuses to
# launch — strategic-Oya degrades to advisory text when core skills are
# absent, and pair-only musubi works regardless.
#
# Pair-only musubi (no Oya) does NOT require this block. Enable it when:
#   - You're running [agents.oyakata].enabled = true AND want strategic
#     supervision (not just process observation)
#   - You want a visible pre-flight check on gstack regardless of Oya
#
# Strategic-Oya treats gstack as its engineering-discipline primitive layer
# (it orchestrates gstack skills across cycles; gstack provides the discipline
# content). Install gstack first if you don't have it, then point the skills
# below at your install.
#
# [requires.skills]
# core = ["cso", "plan-eng-review", "review"]                 # warned-on if missing; strategic-Oya degrades
# recommended = ["plan-ceo-review", "office-hours", "investigate", "codex", "canary", "qa", "design-review"]   # info-only on missing
# path = "~/.claude/skills/gstack"            # override if gstack lives elsewhere
